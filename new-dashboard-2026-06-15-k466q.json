      "panel-4": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    count(*) as count,\n    -- 4. Extract the first word (the actual command) from each piped stage\n    arrayElement(splitByChar(' ', trimBoth(pipe_stage)), 1) as command\nFROM \"default\".\"redis_json\"\nARRAY JOIN content.hook_result.opencode_session_export.data.messages::Array(JSON) as message\nARRAY JOIN message.parts::Array(JSON) as part\n-- 1. Split the full bash command by the pipe character '|'\n-- 2. Use arraySlice to skip the first element (the initial command)\n-- 3. ARRAY JOIN to flatten only the remaining piped commands\nARRAY JOIN arraySlice(splitByString(' | ', part.state.input.command::text), 2) as pipe_stage\nWHERE message.info.role = 'assistant' \n  AND part.type = 'tool'\n  AND part.tool = 'bash'\n  AND part.state.status = 'completed'\n  AND length(trimBoth(command)) \u003e 0\nGROUP BY command\nORDER BY count DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 4,
          "links": [],
          "title": "Pipe Bash Commands",
          "vizConfig": {
