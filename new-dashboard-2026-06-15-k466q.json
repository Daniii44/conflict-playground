                        "value": {
                          "mode": "gradient",
                          "type": "gauge",
                          "valueDisplayMode": "color"
                        }
                      }
                    ]
                  }
                ]
              },
              "options": {
                "cellHeight": "sm",
                "enablePagination": false,
                "showHeader": true,
                "sortBy": []
