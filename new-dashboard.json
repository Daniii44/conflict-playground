      "panel-6": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "SELECT \n    dataset_name::text as label,\n    percentile_node.1 AS percentile,\n    percentile_node.2 AS purity_value\nFROM (\n    SELECT \n        subdataset.name::text AS dataset_name,\n        -- Calculate the quantiles array first within the aggregation block\n        quantilesExact(0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0)(subdataset.purity::float) AS quantiles_array\n    FROM \"default\".\"redis_json\"\n    ARRAY JOIN content.subdatasets::Array(JSON) as subdataset\n    WHERE startsWith(key, 'info:conflict:tilt')\n    GROUP BY dataset_name\n)\n-- Now safely explode the aggregated arrays in the outer layer\nARRAY JOIN arrayZip(\n    [0.0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3, 0.35, 0.4, 0.45, 0.5, 0.55, 0.6, 0.65, 0.7, 0.75, 0.8, 0.85, 0.9, 0.95, 1.0],\n    quantiles_array\n) AS percentile_node\nORDER BY dataset_name, percentile ASC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
