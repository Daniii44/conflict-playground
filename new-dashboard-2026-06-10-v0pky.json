                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "with\n  base as (\n    SELECT\n      arrayElement (splitByString ('resolution:conflict:', key), 2) as resolution,\n      extractGroups (\n        arrayElement (splitByString ('resolution:conflict:', key), 2),\n        '^([^.]+)\\.git-([a-f0-9]{40}):(.*)$'\n      ) AS groups\n    FROM\n      \"default\".\"redis_json\"\n    where\n      startsWith (key, 'resolution')\n      and content.proposed_resolution.error is null\n    order by\n      content.resolution_end::datetime desc\n  )\nSELECT\n  concat(groups[1], '.git') AS repo_name,\n  groups[2] AS merge,\n  groups[3] AS timestamp,\n  'Show Details' as details,\n  case when evaluation.content.incomplete_merge = 0 then 1 else 0 end as complete_merge,\n  case when evaluation.content.perfect_match = 0 then 0 else 1 end as perfect_match\nfrom\n  base\njoin default.redis_json as evaluation on key like concat('evaluation:merge:core:', repo_name, '-', merge, ':', timestamp);"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
