      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    fromUnixTimestamp(message.info.time.created::integer),\n    CASE \n        WHEN part.type = 'text' THEN \n            part.text\n        WHEN part.type = 'tool' THEN \n            concat(coalesce(part.state.title, ''), ' | Command: ', coalesce(part.state.input.command, ''))\n        ELSE concat('[UNUSUAL TYPE: ', part.type, ']')\n    END AS log_line,\n    upper(part.type) as part_type\nFROM \"default\".\"redis_json\"\narray join content.hook_result.opencode_session_export.data.messages::Array(JSON) as message\narray join message.parts::Array(JSON) as part\nwhere key = '${session}'\nand message.info.role = 'assistant' \nand part.type not like 'step-%'"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 2,
          "links": [],
          "title": "Resolution Logs",
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "dedupStrategy": "none",
                "detailsMode": "sidebar",
                "displayedFields": [
                  "part_type",
                  "___LOG_LINE_BODY___"
                ],
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "prettifyLogMessage": true,
                "showControls": true,
                "showFieldSelector": true,
                "showLabels": false,
                "showLevel": false,
                "showTime": true,
                "sortOrder": "Ascending",
                "syntaxHighlighting": false,
                "timestampResolution": "ms",
                "unwrappedColumns": true,
                "wrapLogMessage": true
              }
            },
            "version": "13.0.1"
          }
        }
      },
      "panel-3": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "clickhouse"
                      },
                      "group": "grafana-clickhouse-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "editorType": "sql",
                        "format": 1,
                        "meta": {
                          "builderOptions": {
                            "columns": [],
                            "database": "",
                            "limit": 1000,
                            "mode": "list",
                            "queryType": "table",
                            "table": ""
                          }
                        },
                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "SELECT\n    fromUnixTimestamp(message.info.time.created::integer),\n    CASE \n        WHEN part.tool = 'read' or part.tool = 'edit' THEN \n            basename(part.state.input.filePath)\n        WHEN part.tool = 'bash' THEN \n            part.state.input.command\n        ELSE concat('[UNUSUAL Tool: ', part.tool, ']')\n    END AS log_line,\n    part.tool as part_tool\nFROM \"default\".\"redis_json\"\narray join content.hook_result.opencode_session_export.data.messages::Array(JSON) as message\narray join message.parts::Array(JSON) as part\nwhere key = '${session}'\nand message.info.role = 'assistant' \nand part.type = 'tool'"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 3,
          "links": [],
          "title": "Tool Logs",
          "vizConfig": {
            "group": "logs",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "dedupStrategy": "none",
                "detailsMode": "sidebar",
                "displayedFields": [
                  "part_type",
                  "part_tool",
                  "___LOG_LINE_BODY___",
                  "part_command"
                ],
                "enableInfiniteScrolling": false,
                "enableLogDetails": true,
                "prettifyLogMessage": true,
                "showControls": true,
                "showFieldSelector": true,
                "showLabels": false,
                "showLevel": false,
                "showTime": true,
                "sortOrder": "Ascending",
                "syntaxHighlighting": false,
                "timestampResolution": "ms",
                "unwrappedColumns": true,
                "wrapLogMessage": true
              }
            },
            "version": "13.0.1"
          }
