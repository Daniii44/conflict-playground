                        "queryType": "table",
                        "rawSql": "select key, logical_conflict.type, logical_conflict.info, logical_conflict.paths  from redis_json\narray join content.merge_result.logical_conflicts::Array(JSON) as logical_conflict\nWHERE key LIKE (\n    SELECT '%' || \n           REGEXP_REPLACE(\n               '${resolution}', \n               '([^/]+/[^.]+)\\.git-([a-f0-9]{40}):.*',\n               '\\1.git:\\2'\n           ) || '%'\n);"
                      },
                      "version": "v0"
