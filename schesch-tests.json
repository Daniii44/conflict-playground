                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "with generated_tests as (\nSELECT\n  key,\n  content.duration_seconds::float as generation_duration,\n  length(content.files) as tested_files,\n  content.conflict_info_key::text as conflict_info_key\nFROM\n  \"default\".\"redis_json\"\nwhere\n  startsWith (key, 'dataset:schesch:tests')\n  and content.error is null\n),\ninfo as (\nselect key, count(distinct conflicting_file.path) as conflicting_files\nfrom \"default\".\"redis_json\"\narray join content.merge_result.conflicted_files::Array(JSON) as conflicting_file\nwhere startsWith (key, 'info:conflict')\ngroup by key\n)\nselect key, generation_duration, tested_files, conflicting_files, tested_files/conflicting_files as test_rate from generated_tests\njoin info as info on info.key = conflict_info_key\nlimit 100"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
