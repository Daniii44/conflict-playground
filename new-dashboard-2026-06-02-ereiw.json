                        "rawSql": "SELECT \n    COUNT(CASE WHEN content.octopus_merge_clean::boolean = true THEN 1 END) AS clean,\n    COUNT(CASE WHEN content.octopus_merge_clean::boolean = false THEN 1 END) AS unclean\nFROM \"default\".\"redis_json\"\nWHERE startsWith(key, 'info:conflict:octopus')"
