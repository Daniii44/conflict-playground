                        "pluginVersion": "4.17.0",
                        "queryType": "table",
                        "rawSql": "with conflicted_files_per_merge as (\nSELECT content.merge_commit_oid::String, length(array_agg(distinct file.path)) as conflicted_files_count FROM \"default\".\"redis_json\"\narray join content.merge_result.conflicted_files::Array(JSON) as file\ngroup by content.merge_commit_oid::String\n)\nselect conflicted_files_count, count(*) from conflicted_files_per_merge\ngroup by conflicted_files_count\norder by conflicted_files_count asc\n"
